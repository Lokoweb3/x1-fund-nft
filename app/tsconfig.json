{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../keeper/src/core/*"],
      "@solana/web3.js": ["./node_modules/@solana/web3.js"],
      "@anchor-lang/core": ["./node_modules/@anchor-lang/core"],
      "bn.js": ["./node_modules/@types/bn.js"],
      "buffer": ["./node_modules/buffer"]
    }
  },
  "include": ["src", "../keeper/src/core"]
}
