{
  "name": "fund-nft-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --tsconfig tsconfig.test.json --test test/*.test.ts test/*.test.tsx",
    "test:browser": "tsx --test browser-test/*.test.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.2",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "buffer": "6.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bn.js": "5.1.6",
    "@types/node": "22.10.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vite": "6.3.7"
  },
  "overrides": {
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/web3.js": "1.99.0"
  }
}
